# Copy this file to .env and fill in real values. Never commit the real .env file.

# From the Discord Developer Portal -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=

# Right-click your server icon in Discord (Developer Mode must be on) -> Copy Server ID
DISCORD_GUILD_ID=

# "anthropic" (default, cloud) or "ollama" (local, no API key/cost - see
# "Running with the Ollama backend" in README.md). OPTIONAL - leave blank
# for the default "anthropic" backend.
AI_REVIEW_BACKEND=

# From console.anthropic.com -> API Keys. Only used when AI_REVIEW_BACKEND
# is "anthropic" (the default). OPTIONAL - leave blank to run without AI
# review. Items will skip straight from Data Entry to Queue Review with the
# raw submitted note. Add a key here any time later and restart the bot to
# turn AI review on - no code changes needed.
ANTHROPIC_API_KEY=

# Only used when AI_REVIEW_BACKEND=ollama. Ollama's default local address
# and a vision-capable model - pull it first with `ollama pull moondream`.
# OPTIONAL - leave blank to use these defaults.
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=

# Only used when AI_REVIEW_BACKEND=ollama. Context window (tokens) requested
# from Ollama - its own default of 2048 is easy to exceed once the system
# prompt, note, and an encoded image are all in one request. OPTIONAL -
# leave blank to use the default (4096); raise it if you still see
# "request (N tokens) exceeds the available context size" errors.
OLLAMA_NUM_CTX=

# How long (seconds) to wait for either AI backend before giving up and
# falling back to the raw submitted note. OPTIONAL - leave blank for the
# default (90).
AI_TIMEOUT_SECONDS=

# How often (minutes) the bot automatically retries items whose AI review
# fell back to the raw note (backend unreachable/timed out/bad JSON) - the
# unattended version of Queue Review's "Re-review (AI)" button, for e.g. a
# local Ollama server on another machine that was off overnight.
# AI_RETRY_BATCH_SIZE caps how many it retries per check. OPTIONAL - leave
# blank for the defaults (15 minutes / 10 items).
AI_RETRY_POLL_MINUTES=
AI_RETRY_BATCH_SIZE=

# Optional - defaults to data/pallet_tracker.db if not set
DATABASE_PATH=data/pallet_tracker.db

# Optional - where local photos live. Defaults shown.
PHOTO_DIR=data/photos

# Optional - where manually-submitted invoice files (#submit-invoices) live. Defaults shown.
INVOICE_DIR=data/invoices

# Optional - local backup settings (see "Backups" in README.md). Defaults shown.
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
BACKUP_MAX_AGE_DAYS=14
# Optional - also copy every verified backup into this folder. Point it at a
# Google Drive for desktop folder and the backups appear in Google Drive.
# BACKUP_COPY_DIR=G:\My Drive\Pallet Bot Backups
# BACKUP_COPY_KEEP_COUNT=30

# Optional - days after shipment before buyer data is eligible for removal
# via /pirate-ship purge-buyer-data. Default shown.
BUYER_DATA_RETENTION_DAYS=90

# Optional - days after an item is marked SOLD before its R2-hosted photo
# copies are eligible for removal via /admin purge-old-photos (a buffer in
# case of a return/refund shortly after the sale). Default shown. Only
# meaningful if R2 is configured above.
PHOTO_RETENTION_DAYS_AFTER_SALE=30

# Optional - where role-ID bindings (see "Role bindings" in README.md,
# /bind-role) are stored. Defaults shown - you don't need to set this by
# hand, /bind-role manages it.
SETTINGS_PATH=data/settings.json

# From developer.ebay.com -> your application's keys, once the developer API
# application is approved. EBAY_REFRESH_TOKEN comes from completing eBay's
# OAuth consent flow once, by hand ("Sign in with eBay" / Get a Token on
# your app's page) - it's long-lived (~18 months) and ebay_api.py exchanges
# it for short-lived access tokens on demand; there's no in-Discord
# "connect" command for this. OPTIONAL - leave all three blank to run
# without the direct eBay API. Until every one of these is set, "List on
# eBay" won't show up and eBay orders/fees aren't synced.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=

# Optional - "production" (default) or "sandbox". Use "sandbox" with
# sandbox credentials (a separate keyset/token from developer.ebay.com's
# Sandbox tab) to test the API path without creating real listings.
EBAY_ENVIRONMENT=production

# Optional - how often (minutes) the eBay order auto-sync poller checks
# for new orders (cogs/ebay.py's order_poll_loop -> #ebay-orders). Needs
# EBAY_REFRESH_TOKEN to carry the sell.fulfillment scope - a wider
# re-consent than the sell.inventory scope listing creation needs alone;
# see README's "eBay order auto-sync" section for the walkthrough. Runs
# (and harmlessly fails every poll, logged not surfaced in Discord) even
# without that wider scope, so there's no harm leaving EBAY_ENABLED on in
# the meantime.
EBAY_ORDER_POLL_MINUTES=20

# Optional - on by default. On each order poll above, moves a tracked item
# to Sold when its eBay order comes in and to Shipped once eBay shows it
# shipped (no Mark as Sold / Mark as Shipped clicks for eBay sales). A
# cancelled order only posts an alert to #ebay-orders - nothing is undone
# automatically - and QuickBooks logging stays the "Confirm & log sale"
# click. Set to false for the fully manual buttons.
EBAY_ORDER_AUTOMATION=true
EBAY_ORDER_AUTOMATION_LOOKBACK_DAYS=3

# eBay fee expenses - a "Confirm & log fees" card per eBay order in
# #ebay-orders that books eBay's fees, eBay shipping labels and ad fees to
# QuickBooks (Journal Entry: debit these accounts, credit Undeposited
# Funds) and adds them to the pallet's cost. Needs the sell.finances scope
# (see README "eBay fee expenses"). REQUIRED before anything can post: the
# QuickBooks expense account for eBay fees - find its ID with
# /finance list-accounts account_type:"All account types". No default on
# purpose. Shipping/ads use the fees account unless set separately.
QUICKBOOKS_EBAY_FEES_ACCOUNT_ID=
QUICKBOOKS_EBAY_SHIPPING_ACCOUNT_ID=
QUICKBOOKS_EBAY_ADS_ACCOUNT_ID=
EBAY_FEE_CARDS=true
EBAY_FEE_SYNC_MINUTES=60
EBAY_FEE_CARD_DELAY_DAYS=5
# Blank = only orders from the day this first runs (use /ebay fee-cards
# since:YYYY-MM-DD for older ones).
EBAY_FEE_CARDS_START_DATE=
# Refunds are booked against this income account (debited). Blank = eBay
# Sales for eBay refunds, Sales for /finance refund. e.g. your "Refunds &
# discounts to customers" account's ID, to see refunds on their own line.
QUICKBOOKS_REFUNDS_ACCOUNT_ID=
# 🏦 payout cards: record each eBay payout as a QuickBooks Bank Deposit into
# QUICKBOOKS_BANK_ACCOUNT_ID once everything in it is logged.
EBAY_PAYOUT_CARDS=true

# Copy each Listed item's live eBay price into the bot every N minutes
# (Discord card, website checkout, dashboard). Fixed-price listings only.
EBAY_PRICE_SYNC=true
EBAY_PRICE_SYNC_MINUTES=60

# Optional - defaults to EBAY_US (the only marketplace this bot's category
# taxonomy is built for).
EBAY_MARKETPLACE_ID=EBAY_US

# REQUIRED once the three credentials above are set, to actually publish a
# listing (create_listing() checks these and fails with a clear message
# naming whichever is blank, rather than a confusing eBay API error).
#
# EBAY_MERCHANT_LOCATION_KEY identifies an inventory location you've already
# created on your eBay seller account (Seller Hub > Shipping preferences, or
# eBay's Account API) - this bot doesn't create one for you.
#
# EBAY_FULFILLMENT_POLICY_ID/EBAY_PAYMENT_POLICY_ID/EBAY_RETURN_POLICY_ID are
# your Business Policy IDs (Seller Hub > Business Policies - each policy's ID
# is shown alongside its name, or fetch them via eBay's Account API:
# GET /sell/account/v1/fulfillment_policy, .../payment_policy, .../return_policy).
# These are IDs, not policy names.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# Legacy archive folders from the removed eBay/Facebook CSV exports - only
# read so old files there still get included in backups. Defaults shown.
EBAY_BATCH_ARCHIVE_DIR=data/ebay_batch_archive
FB_MARKETPLACE_BATCH_ARCHIVE_DIR=data/fb_marketplace_batch_archive

# From your Cloudflare dashboard -> R2 -> Manage API Tokens (account ID is
# shown on the R2 overview page). OPTIONAL - leave all five blank to run
# without R2 photo hosting; the local photo copy still works for Discord
# item cards either way, but List on eBay needs R2's public photo URLs
# since Discord's own attachment links expire.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Your bucket's public base URL (R2.dev subdomain or a custom domain you've
# connected to the bucket), no trailing slash - e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL_BASE=

# Optional - QuickBooks Online integration (quickbooks.py, /finance
# connect-quickbooks). CLIENT_ID/CLIENT_SECRET come from a registered app
# at https://developer.intuit.com (My Apps -> create an app -> Keys &
# OAuth). ENVIRONMENT is "sandbox" or "production" - must match whichever
# set of keys you're using. REDIRECT_URI must be entered EXACTLY as one of
# the app's registered "Redirect URIs" - this bot has no web server to
# actually receive it, so http://localhost:8000/callback works fine as a
# placeholder (see config.py's QuickBooks section for the full flow).
# Leave CLIENT_ID/CLIENT_SECRET blank to run without QuickBooks entirely.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback
# Only if the business has a credit card account in QuickBooks: its
# Account ID (/finance list-accounts) - new charges on it then show up in
# #credit-card-charges to allocate to pallets. Leave blank if there's no
# card (nothing is watched).
QUICKBOOKS_CREDIT_CARD_ACCOUNT_ID=
# How often (minutes) the card poller runs and #finance-dashboard refreshes.
QUICKBOOKS_POLL_MINUTES=20
# The /finance overview early-warning margin threshold, as a percent.
QUICKBOOKS_MARGIN_WARNING_THRESHOLD_PCT=20

# /finance log-sale - see config.py's own comment for what each of these
# points at. Defaults match the real setup already in the connected
# company; only change these if that QuickBooks setup changes.
QUICKBOOKS_CASH_SALES_ITEM_ID=2
QUICKBOOKS_CASH_SALES_CUSTOMER_ID=1
QUICKBOOKS_SALES_INCOME_ACCOUNT_ID=7
QUICKBOOKS_EBAY_SALES_ACCOUNT_ID=98
# One Product/Service per channel so the P&L splits Sales by channel
# (QuickBooks books a receipt to its Item's income account). Blank = use
# QUICKBOOKS_CASH_SALES_ITEM_ID as before. "Other" = anything not eBay/In Person.
QUICKBOOKS_EBAY_SALES_ITEM_ID=3
QUICKBOOKS_IN_PERSON_SALES_ITEM_ID=4
QUICKBOOKS_OTHER_SALES_ITEM_ID=5
QUICKBOOKS_COGS_ACCOUNT_ID=48
QUICKBOOKS_UNDEPOSITED_FUNDS_ACCOUNT_ID=24
# The business bank account (e.g. Old National checking) - find its ID with
# /finance list-accounts. Used for sales logged as already deposited, as the
# account claimed invoices are paid from, and for the bank balance on
# /finance overview and #finance-dashboard. 8 = the old "Cash" account.
QUICKBOOKS_BANK_ACCOUNT_ID=8

# Optional - the web dashboard (webapp/): the same bot as a website, signed
# in with Discord, same roles. See README's "Web dashboard" section.
WEB_DASHBOARD_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8080
# The public https address the Cloudflare Tunnel serves it at.
WEB_BASE_URL=https://dash.example.com
# Discord Developer Portal -> your bot's application -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional - sign in to the dashboard by typing a Discord username, no password.
# Anyone who knows a member's username gets that member's access. Off unless true.
WEB_USERNAME_LOGIN=false
WEB_MAX_UPLOAD_MB=15

# Optional - Stripe website checkout (needs the web dashboard on). Use TEST
# keys first. Never put keys anywhere but this file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional - Stripe TEST keys used ONLY for the /admin checkout-test item, so it
# can be tested while real sales stay live. Webhook secret = the signing secret
# of a TEST-mode endpoint at the same /stripe/webhook URL.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://4guys1palletoverstock.com/checkout/success
STRIPE_CANCEL_URL=https://4guys1palletoverstock.com/cart
STRIPE_SHOP_ORIGINS=https://4guys1palletoverstock.com
# Shared with the website's server (its PALLET_BOT_SHOP_KEY) - any long random string.
STRIPE_SHOP_SERVER_KEY=
# Extra test items (besides /admin checkout-test) the website may buy without an eBay listing - honored
# ONLY while STRIPE_SECRET_KEY is a sk_test_ key (docs/website-checkout.md section 7).
SHOP_TEST_SKUS=
# Website catalog: how often the bot re-reads the live eBay listings, and
# how old that read may be before /shop/catalog answers 503.
EBAY_CATALOG_SYNC_MINUTES=20
EBAY_CATALOG_MAX_AGE_MINUTES=60
# 0 = free shipping
STRIPE_SHIPPING_PRICE=0
STRIPE_SHIPPING_LABEL=Free shipping
# Shipping: flat = STRIPE_SHIPPING_PRICE per order (above). custom = each item
# priced from its size + weight: billable lb = max(weight, L x W x H / 166),
# rounded up; price = first lb + per extra lb + handling (min / optional max).
# Items with no weight use SHIP_DEFAULT. An order ships for the sum of its items.
SHIPPING_MODE=flat
SHIP_FIRST_LB=6.00
SHIP_PER_EXTRA_LB=0.90
SHIP_HANDLING=1.00
SHIP_MIN=5.99
SHIP_MAX=0
SHIP_DEFAULT=14.99
SHIP_LABEL=Standard shipping
SHIP_LOCAL_PICKUP=true
# SHIPPING_MODE=shippo: live carrier rates for the buyer's ZIP (Shippo). The
# website calls POST /shop/shipping/quote, then passes shipping_quote_id to
# checkout. Each item ships as its own box (its saved size/weight, else
# SHIP_DEFAULT_PARCEL "L x W x H x lb"); charge = cheapest rate + markup% + handling.
SHIPPO_API_TOKEN=
SHIPPO_CARRIERS=
SHIPPO_HANDLING=1.00
SHIPPO_MARKUP_PERCENT=0
SHIPPO_QUOTE_MINUTES=60
SHIP_DEFAULT_PARCEL=14x12x10x8
SHIP_FROM_NAME=Four Guys One Pallet Overstock
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=IN
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=
STRIPE_HOLD_MINUTES=30
STRIPE_LINK_HOURS=24
# QuickBooks: the "Website Sale" product (income account Website Sales), the
# sales-tax payable account, and the account for Stripe's fee.
QUICKBOOKS_WEBSITE_SALES_ITEM_ID=6
QUICKBOOKS_SALES_TAX_PAYABLE_ACCOUNT_ID=111
QUICKBOOKS_STRIPE_FEES_ACCOUNT_ID=83

# Optional - integrated website-shop publishing (cogs/website_shop.py). Adds
# a "#website_shop" approval flow to THIS bot for publishing items to a
# separate storefront website - see README.md's "Website shop" section.
# Off unless WEBSITE_SHOP_ENABLED=true; every setting below is required once
# it is.
WEBSITE_SHOP_ENABLED=false
# The Discord channel ID of your dedicated #website_shop review channel.
WEBSITE_SHOP_CHANNEL_ID=
# Staff Discord user IDs allowed to act in #website_shop, comma-separated
# (right-click a user with Developer Mode on -> Copy User ID).
WEBSITE_SHOP_OPERATOR_IDS=
# Your website's existing DISCORD_SYNC_* values, copied exactly - never
# invent new ones.
WEBSITE_URL=
WEBSITE_SOURCE_ID=
WEBSITE_SECRET=
# Staged rollout: leave false to run the review flow without sending
# anything to the website yet; set true only once you've confirmed it
# behaves correctly.
WEBSITE_PUBLISH_ENABLED=false
WEBSITE_SHOP_POLL_SECONDS=30
