# Copy this file to .env and fill in real values. Never commit the real .env file.

# From the Discord Developer Portal -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=

# Right-click your server icon in Discord (Developer Mode must be on) -> Copy Server ID
DISCORD_GUILD_ID=

# "anthropic" (default, cloud) or "ollama" (local, no API key/cost - see
# "Running with the Ollama backend" in README.md). OPTIONAL - leave blank
# for the default "anthropic" backend.
AI_REVIEW_BACKEND=

# From console.anthropic.com -> API Keys. Only used when AI_REVIEW_BACKEND
# is "anthropic" (the default). OPTIONAL - leave blank to run without AI
# review. Items will skip straight from Data Entry to Queue Review with the
# raw submitted note. Add a key here any time later and restart the bot to
# turn AI review on - no code changes needed.
ANTHROPIC_API_KEY=

# Only used when AI_REVIEW_BACKEND=ollama. Ollama's default local address
# and a vision-capable model - pull it first with `ollama pull moondream`.
# OPTIONAL - leave blank to use these defaults.
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=

# Only used when AI_REVIEW_BACKEND=ollama. Context window (tokens) requested
# from Ollama - its own default of 2048 is easy to exceed once the system
# prompt, note, and an encoded image are all in one request. OPTIONAL -
# leave blank to use the default (4096); raise it if you still see
# "request (N tokens) exceeds the available context size" errors.
OLLAMA_NUM_CTX=

# How long (seconds) to wait for either AI backend before giving up and
# falling back to the raw submitted note. OPTIONAL - leave blank for the
# default (90).
AI_TIMEOUT_SECONDS=

# Optional - defaults to data/pallet_tracker.db if not set
DATABASE_PATH=data/pallet_tracker.db

# Optional - where local photos live. Defaults shown.
PHOTO_DIR=data/photos

# Optional - local backup settings (see "Backups" in README.md). Defaults shown.
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
BACKUP_MAX_AGE_DAYS=14

# Optional - days after shipment before buyer data is eligible for removal
# via /pirate-ship purge-buyer-data. Default shown.
BUYER_DATA_RETENTION_DAYS=90

# Optional - where role-ID bindings (see "Role bindings" in README.md,
# /bind-role) are stored. Defaults shown - you don't need to set this by
# hand, /bind-role manages it.
SETTINGS_PATH=data/settings.json

# From developer.ebay.com -> your application's keys, once the developer API
# application is approved. OPTIONAL - leave all four blank to run without the
# direct eBay API listing path. Until every one of these is set, "List on
# eBay (API)" won't even show up, and the eBay CSV batch path (Add to eBay
# Batch / /ebay export-batch) is the only way to get items onto eBay.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=

# Optional - where the eBay CSV batch lives / gets archived. Defaults shown.
EBAY_BATCH_CSV_PATH=data/ebay_batch.csv
EBAY_BATCH_ARCHIVE_DIR=data/ebay_batch_archive

# REQUIRED before /ebay export-batch will export anything - your seller
# account's real ship-from location (city/state, or a ZIP code). eBay
# rejects every row in a bulk upload without this ("No <Item.Location>
# exists"), so leaving it blank isn't a safe default the way most of this
# file's other optional settings are.
EBAY_ITEM_LOCATION=

# ALSO REQUIRED before /ebay export-batch will export anything - eBay
# rejects every row without at least one shipping service too ("Please add
# at least one valid shipping service option to your listing"). Uses eBay's
# Calculated (weight-based) shipping type, not one flat cost for every item -
# each item's own weight/dimensions (captured as required fields on
# EbayListingModal at Queue Review approval, see item_flow.py - Automated
# Review's AI pre-fills a rough estimate, always human-confirmed before
# Approve) drive the actual per-listing charge, so a small light item and a
# big heavy one aren't priced the same. This same weight/dimension data also
# fills in the Pirate Ship export's Weight/Length/Width/Height columns (see
# pirate_ship_csv.py), regardless of which platform the item ends up selling
# on. EBAY_SHIPPING_SERVICE must be a real eBay ShippingService code (e.g.
# USPSPriority, USPSGround, UPSGround) - it says WHICH carrier service to
# calculate with, not a price - and EBAY_SHIPPING_PACKAGE_TYPE must be a real
# eBay ShippingPackage code (e.g. PackageThickEnvelope, IrregularPackage -
# what's right depends on what you're actually shipping). Neither has a safe
# default to guess any more than EBAY_ITEM_LOCATION did - verify both via
# eBay's own listing flow (start a listing by hand, choose Calculated
# shipping, see what it's called) rather than trusting these examples blindly.
EBAY_SHIPPING_TYPE=Calculated
EBAY_SHIPPING_SERVICE=
EBAY_SHIPPING_PACKAGE_TYPE=

# From your Cloudflare dashboard -> R2 -> Manage API Tokens (account ID is
# shown on the R2 overview page). OPTIONAL - leave all five blank to run
# without R2 photo hosting; the local photo copy still works for Discord
# item cards either way, but the eBay CSV batch's PicURL column stays blank
# since Discord's own attachment links expire and can't be used there.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Your bucket's public base URL (R2.dev subdomain or a custom domain you've
# connected to the bucket), no trailing slash - e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL_BASE=
